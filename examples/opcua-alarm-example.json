        "type": "comment",
        "z": "opcua-alarm-flow",
        "name": "--- Event Alarm Nodes (one per alarm) ---",
        "info": "Each event-alarm node monitors one ActiveState_Id topic.\nCondition: active == true triggers the alarm.\nOutputs: Raised | Acknowledged | Cleared | Resolved",
        "x": 800,
        "y": 80,
        "wires": []
