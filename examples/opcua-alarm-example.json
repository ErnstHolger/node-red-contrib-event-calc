        "z": "opcua-alarm-flow",
        "name": "--- Simulated OPC UA Inputs (use inject buttons to simulate) ---",
        "info": "These inject nodes simulate the OPC UA ActiveState_Id values.\nReplace with actual OPC-UA-Client nodes for real use.",
        "x": 280,
        "y": 80,
        "wires": []
    },
