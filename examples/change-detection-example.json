[
    {
        "id": "change-detection-flow",
        "type": "tab",
        "label": "Change Detection Example",
        "disabled": false,
        "info": "Demonstrates hasChanged(), timeSinceLastChange(), now(), and prev() functions.\n\n1. Click 'Send 22' then 'Send 22' again (same value) - hasChanged returns false\n2. Click 'Send 25' (different value) - hasChanged returns true\n3. Watch timeSinceLastChange grow between clicks"
    },
    {
        "id": "cache-cd",
        "type": "event-cache",
        "name": "CD Cache",
        "maxEntries": "10000",
        "ttl": "0"
    },
    {
        "id": "inject-val-22",
        "type": "inject",
        "z": "change-detection-flow",
        "name": "Send 22",
        "props": [
            { "p": "topic", "vt": "str" },
            { "p": "payload" }
        ],
        "topic": "sensor/temperature",
        "payload": "22",
        "payloadType": "num",
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "x": 130,
        "y": 100,
        "wires": [["event-in-cd"]]
    },
    {
        "id": "inject-val-25",
        "type": "inject",
        "z": "change-detection-flow",
        "name": "Send 25",
        "props": [
            { "p": "topic", "vt": "str" },
            { "p": "payload" }
        ],
        "topic": "sensor/temperature",
        "payload": "25",
        "payloadType": "num",
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "x": 130,
        "y": 160,
        "wires": [["event-in-cd"]]
    },
    {
        "id": "inject-val-30",
        "type": "inject",
        "z": "change-detection-flow",
        "name": "Send 30",
        "props": [
            { "p": "topic", "vt": "str" },
            { "p": "payload" }
        ],
        "topic": "sensor/temperature",
        "payload": "30",
        "payloadType": "num",
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "x": 130,
        "y": 220,
        "wires": [["event-in-cd"]]
    },
    {
        "id": "event-in-cd",
        "type": "event-in",
        "z": "change-detection-flow",
        "name": "",
        "cache": "cache-cd",
        "topicField": "topic",
        "valueField": "payload",
        "x": 330,
        "y": 160,
        "wires": [[]]
    },
    {
        "id": "calc-has-changed",
        "type": "event-calc",
        "z": "change-detection-flow",
        "name": "Has Changed?",
        "cache": "cache-cd",
        "inputMappings": [
            { "name": "temp", "pattern": "sensor/temperature" }
        ],
        "expression": "hasChanged('temp')",
        "triggerOn": "any",
        "outputTopic": "calc/has_changed",
        "x": 330,
        "y": 300,
        "wires": [["debug-changed"], []]
    },
    {
        "id": "debug-changed",
        "type": "debug",
        "z": "change-detection-flow",
        "name": "hasChanged result",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 560,
        "y": 300,
        "wires": []
    },
    {
        "id": "calc-time-since",
        "type": "event-calc",
        "z": "change-detection-flow",
        "name": "Time Since Change (sec)",
        "cache": "cache-cd",
        "inputMappings": [
            { "name": "temp", "pattern": "sensor/temperature" }
        ],
        "expression": "round(timeSinceLastChange('temp') / 1000, 1)",
        "triggerOn": "any",
        "outputTopic": "calc/time_since_change",
        "x": 370,
        "y": 370,
        "wires": [["debug-time-since"], []]
    },
    {
        "id": "debug-time-since",
        "type": "debug",
        "z": "change-detection-flow",
        "name": "timeSinceLastChange (s)",
        "active": true,
        "tosidebar": true,
        "console": false,
        "tostatus": true,
        "complete": "payload",
        "targetType": "msg",
        "statusVal": "payload",
        "statusType": "auto",
        "x": 610,
        "y": 370,
        "wires": []
    },
    {
        "id": "calc-prev-value",
        "type": "event-calc",
